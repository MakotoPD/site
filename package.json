{
  "name": "makoto-studio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.11.1"
  },
  "scripts": {
    "dev": "node scripts/run.mjs nuxt dev --host 127.0.0.1 --port 3010",
    "build": "node scripts/run.mjs nuxt build",
    "preview": "node scripts/run.mjs .output/server/index.mjs",
    "postinstall": "node scripts/run.mjs nuxt prepare",
    "typecheck": "node scripts/run.mjs nuxt typecheck",
    "admin:setup": "node scripts/run.mjs scripts/setup-admin.mjs",
    "test": "node scripts/run.mjs --test tests/*.test.mjs",
    "test:integration": "node scripts/run.mjs tests/integration.mjs",
    "db:start": "docker compose up -d postgres",
    "db:migrate": "node scripts/run.mjs scripts/migrate-storage.mjs",
    "storage:check": "node scripts/run.mjs scripts/check-storage.mjs",
    "runtime:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-runtime.ps1",
    "format": "node scripts/run.mjs scripts/format.mjs",
    "format:check": "node scripts/run.mjs scripts/format.mjs --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1150.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@iconify-json/simple-icons": "1.2.100",
    "@lucide/vue": "1.56.0",
    "@nuxt/fonts": "1.0.1",
    "@nuxt/icon": "2.5.1",
    "@nuxtjs/robots": "7.0.2",
    "@nuxtjs/seo": "6.0.1",
    "@nuxtjs/sitemap": "9.0.2",
    "@nuxtjs/turnstile": "1.1.3",
    "@tailwindcss/vite": "4.3.3",
    "@takumi-rs/core": "2.15.2",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-code-block-lowlight": "3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-subscript": "3.31.4",
    "@tiptap/extension-superscript": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-task-item": "3.31.4",
    "@tiptap/extension-task-list": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@tiptap/vue-3": "3.31.4",
    "@types/three": "0.186.0",
    "gsap": "3.15.0",
    "lowlight": "3.3.0",
    "markdown-it": "15.0.2",
    "nodemailer": "10.1.0",
    "nuxt": "4.6.1",
    "nuxt-og-image": "7.0.3",
    "pg": "8.23.1",
    "reka-ui": "2.10.5",
    "site-config-stack": "5.0.2",
    "tailwindcss": "4.3.3",
    "three": "0.186.1",
    "vue": "3.5.44",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@vue/compiler-dom": "3.5.44",
    "@vue/compiler-sfc": "3.5.44",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.5",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "@nuxt/kit": "4.6.1",
    "@nuxt/schema": "4.6.1",
    "simple-git": "^4.0.2",
    "@simple-git/argv-parser": "^2.0.1"
  }
}
