# Uruchom npm run admin:setup, aby utworzyć lokalne dane logowania.
NUXT_ADMIN_EMAIL=contact@makoto.com.pl
NUXT_ADMIN_PASSWORD_HASH=
NUXT_PUBLIC_SITE_URL=https://makoto.com.pl
# Włącz dopiero na docelowej domenie produkcyjnej.
NUXT_PUBLIC_INDEXABLE=false
NUXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NUXT_PUBLIC_BING_SITE_VERIFICATION=
# Stały, losowy sekret podpisywania obrazów OG (np. 32 bajty jako hex). Tylko serwer.
NUXT_APP_SECRET=
# Nagłówek z adresem odwiedzającego ustawiany przez Cloudflare (pomarańczowa chmurka).
# Serwer musi przyjmować ruch tylko od Cloudflare, inaczej nagłówek da się podrobić.
# Pusta wartość = X-Forwarded-For od lokalnego reverse proxy.
NUXT_CLIENT_IP_HEADER=cf-connecting-ip
# Te same klucze Cloudflare Turnstile co na dotychczasowej stronie.
# Klucz secret jest wyłącznie serwerowy. Lokalny dev korzysta z oficjalnych kluczy testowych.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=
# Trackery działają tylko na domenie SITE_URL, poza /admin, po zgodzie.
NUXT_PUBLIC_ANALYTICS_ENABLED=true
NUXT_PUBLIC_ANALYTICS_GA_ID=G-7P472XF9TT
NUXT_PUBLIC_ANALYTICS_UMAMI_ID=84056d40-a170-4a24-9d8a-e10d2144dd7e
# Powiadomienia e-mail o nowych zgłoszeniach (formularz kontaktowy i kalkulator).
# Puste HOST lub TO = bez powiadomień. Port 587 (STARTTLS) albo 465. TO: adresy po przecinku.
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=587
NUXT_SMTP_USER=
NUXT_SMTP_PASSWORD=
NUXT_SMTP_TO=
# Lokalny PostgreSQL: npm run db:start. Ustaw silne hasło w obu miejscach.
# Produkcja (Dokploy): ustaw tylko NUXT_DATABASE_URL na adres wewnętrzny swojej bazy.
MAKOTO_POSTGRES_PASSWORD=replace-with-a-long-random-password
NUXT_DATABASE_URL=postgresql://makoto_studio:replace-with-a-long-random-password@127.0.0.1:5434/makoto_studio
NUXT_DATABASE_SCHEMA=makoto_studio
# Cloudflare R2. Klucze są wyłącznie serwerowe; nie commituj pliku .env.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=makoto-portfolio
# Dla bucketu EU użyj https://<account-id>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=
NUXT_R2_PREFIX=makoto-studio
